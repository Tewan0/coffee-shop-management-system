# Coffee Shop Management System - Backend Environment Variables
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Store Owner Configuration (Must match the owner's Google account email)
OWNER_EMAIL=owner@coffeeshop.com

# Firebase Cloud Firestore & Auth Configuration
# Path to your Firebase service account JSON key file (relative or absolute)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Set to true if running without Firebase credentials in local development / offline demo
USE_MOCK_DB=false

